<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistema Unificado de Alojamientos</title>
    <!-- Bootstrap 5 CDN CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

    {% url 'alojamientos_app:crear' as url_alojamientos_crear %}
    {% url 'alojamientos_app:global' as url_alojamientos_global %}
    {% url 'cabanas_app:crear_cabanas' as url_cabanas_crear %}
    {% url 'clientes_app:crear_cliente' as url_clientes_crear %}
    {% url 'reservas_app:clientes' as url_reservas_clientes %}
    {% url 'reservas_app:crear_clientes' as url_reservas_crear_clientes %}
    {% url 'reservas_app:crear_reservas' as url_reservas_crear %}
    {% url 'panel_central' as url_panel_central %}
    {% url 'ayuda' as url_ayuda %}
    {% url 'contacto' as url_contacto %}

    <!-- Barra de navegación superior -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-5 shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold" href="{% url 'sistema_unificado' %}">🏨 Sistema Alojamiento</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal" aria-controls="menuPrincipal" aria-expanded="false" aria-label="Mostrar menú">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="menuPrincipal">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                    <li class="nav-item"><a class="nav-link" href="{% url 'home' %}">Inicio / Dashboard</a></li>

                    <!-- Toggle Clientes -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="toggleClientes" role="button" data-bs-toggle="dropdown" aria-expanded="false">Clientes</a>
                        <ul class="dropdown-menu" aria-labelledby="toggleClientes">
                            <li><a class="dropdown-item" href="{% url 'menu_clientes' %}">Menú Clientes</a></li>
                            <li><a class="dropdown-item" href="{% url 'clientes_app:lista' %}">Lista de Clientes</a></li>
                            {% if url_clientes_crear %}<li><a class="dropdown-item" href="{{ url_clientes_crear }}">Crear Cliente</a></li>{% endif %}
                        </ul>
                    </li>

                    <!-- Toggle Reservas -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="toggleReservas" role="button" data-bs-toggle="dropdown" aria-expanded="false">Reservas</a>
                        <ul class="dropdown-menu" aria-labelledby="toggleReservas">
                            <li><a class="dropdown-item" href="{% url 'menu_reservas' %}">Menú Reservas</a></li>
                            <li><a class="dropdown-item" href="{% url 'reservas_app:lista' %}">Lista de Reservas</a></li>
                            {% if url_reservas_crear %}<li><a class="dropdown-item" href="{{ url_reservas_crear }}">Crear Reserva</a></li>{% endif %}
                            {% if url_reservas_clientes %}<li><a class="dropdown-item" href="{{ url_reservas_clientes }}">Clientes de Reservas</a></li>{% endif %}
                            {% if url_reservas_crear_clientes %}<li><a class="dropdown-item" href="{{ url_reservas_crear_clientes }}">Crear Cliente (Reservas)</a></li>{% endif %}
                        </ul>
                    </li>

                    <!-- Toggle Cabañas -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="toggleCabanas" role="button" data-bs-toggle="dropdown" aria-expanded="false">Cabañas</a>
                        <ul class="dropdown-menu" aria-labelledby="toggleCabanas">
                            <li><a class="dropdown-item" href="{% url 'menu_cabanas' %}">Menú Cabañas</a></li>
                            <li><a class="dropdown-item" href="{% url 'cabanas_app:lista_cabanas' %}">Lista de Cabañas</a></li>
                            {% if url_cabanas_crear %}<li><a class="dropdown-item" href="{{ url_cabanas_crear }}">Crear Cabaña</a></li>{% endif %}
                        </ul>
                    </li>

                    <!-- Toggle Alojamientos -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="toggleAlojamientos" role="button" data-bs-toggle="dropdown" aria-expanded="false">Alojamientos</a>
                        <ul class="dropdown-menu" aria-labelledby="toggleAlojamientos">
                            <li><a class="dropdown-item" href="{% url 'menu_alojamientos' %}">Menú Alojamientos</a></li>
                            <li><a class="dropdown-item" href="{% url 'alojamientos_app:lista_alojamientos' %}">Lista de Alojamientos</a></li>
                            {% if url_alojamientos_crear %}<li><a class="dropdown-item" href="{{ url_alojamientos_crear }}">Crear Alojamiento</a></li>{% endif %}
                            {% if url_alojamientos_global %}<li><a class="dropdown-item" href="{{ url_alojamientos_global }}">Vista Global</a></li>{% endif %}
                        </ul>
                    </li>

                    <!-- Toggle Sistema -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="toggleSistema" role="button" data-bs-toggle="dropdown" aria-expanded="false">Sistema</a>
                        <ul class="dropdown-menu" aria-labelledby="toggleSistema">
                            {% if url_panel_central %}<li><a class="dropdown-item" href="{{ url_panel_central }}">Panel Central</a></li>{% endif %}
                            {% if url_ayuda %}<li><a class="dropdown-item" href="{{ url_ayuda }}">Ayuda</a></li>{% endif %}
                            {% if url_contacto %}<li><a class="dropdown-item" href="{{ url_contacto }}">Contacto</a></li>{% endif %}
                        </ul>
                    </li>

                </ul>
                <div class="ms-auto">
                    <a href="/admin/" class="btn btn-outline-light btn-sm" target="_blank">⚙️ Panel Admin</a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Contenido Principal -->
    <main class="container">
        <div class="row text-center mb-5">
            <div class="col-md-12">
                <h1 class="display-5 fw-bold text-dark">Panel Central de Control</h1>
                <p class="lead text-muted">Selecciona el módulo del sistema que deseas gestionar a continuación:</p>
            </div>
        </div>

        <!-- Tarjetas de Navegación por Módulo -->
        <div class="row g-4 text-center">

            <!-- Módulo de Clientes -->
            <div class="col-md-3">
                <div class="card border-primary shadow-sm h-100">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <h5 class="card-title text-primary fw-bold">Clientes</h5>
                            <p class="card-text text-muted small mt-2">Gestiona el listado y registro de huéspedes y clientes.</p>
                        </div>
                        <a href="{% url 'clientes_app:lista' %}" class="btn btn-primary mt-3 w-100">Ir a Clientes</a>
                    </div>
                </div>
            </div>

            <!-- Módulo de Reservas -->
            <div class="col-md-3">
                <div class="card border-success shadow-sm h-100">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <h5 class="card-title text-success fw-bold">Reservas</h5>
                            <p class="card-text text-muted small mt-2">Controla fechas, estados y reservas activas.</p>
                        </div>
                        <a href="{% url 'reservas_app:lista' %}" class="btn btn-success mt-3 w-100">Ir a Reservas</a>
                    </div>
                </div>
            </div>

            <!-- Módulo de Cabañas -->
            <div class="col-md-3">
                <div class="card border-warning shadow-sm h-100">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <h5 class="card-title text-warning fw-bold">Cabañas</h5>
                            <p class="card-text text-muted small mt-2">Administra el catálogo y detalles de cabañas.</p>
                        </div>
                        <a href="{% url 'cabanas_app:lista_cabanas' %}" class="btn btn-warning text-white mt-3 w-100">Ir a Cabañas</a>
                    </div>
                </div>
            </div>

            <!-- Módulo de Alojamientos -->
            <div class="col-md-3">
                <div class="card border-info shadow-sm h-100">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <h5 class="card-title text-info fw-bold">Alojamientos</h5>
                            <p class="card-text text-muted small mt-2">Revisa el listado general de alojamientos.</p>
                        </div>
                        <a href="{% url 'alojamientos_app:lista_alojamientos' %}" class="btn btn-info text-white mt-3 w-100">Ir a Alojamientos</a>
                    </div>
                </div>
            </div>

        </div>

        <!-- Pie de página -->
        <div class="row mt-5">
            <div class="col-md-12 text-center text-muted small">
                <hr>
                <p>Sistema Integral de Gestión de Alojamientos &copy; 2026</p>
            </div>
        </div>
    </main>

    <!-- Bootstrap 5 JS Bundle CDN -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>